# Envío de formularios (contacto + test). Sin esta clave los leads se registran en los logs de Vercel.
RESEND_API_KEY=
# Remitente verificado en Resend (ej. "Lateral Zinkin <web@lateralzinkin.com>")
LEAD_FROM_EMAIL=Lateral Zinkin <onboarding@resend.dev>
# Destino de los leads
LEAD_TO_EMAIL=lateral@lateralzinkin.com

# URL pública de reservas (Cal.com / Calendly). Si está vacía se muestra el formulario.
NEXT_PUBLIC_BOOKING_URL=
# URL de la newsletter en Substack
NEXT_PUBLIC_SUBSTACK_URL=https://lateralzinkin.substack.com
# URL canónica del sitio
NEXT_PUBLIC_SITE_URL=https://lateralzinkin.vercel.app
